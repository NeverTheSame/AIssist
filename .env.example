# Copy this file to .env and fill in real values.
# If .env is missing entirely, config.py falls back to these placeholder
# defaults (with a warning) so the repo stays importable for tests/CI.

# --- AI Service Configuration (Primary) ---
AI_SERVICE_API_KEY=your-api-key
AI_SERVICE_ENDPOINT=https://your-resource.openai.azure.com/
AI_SERVICE_MODEL_NAME=gpt-4o
AI_SERVICE_DEPLOYMENT_NAME=your-deployment-name
AI_SERVICE_API_VERSION=2024-02-15-preview
# Optional: faster/smaller model for free-text prompt generation. If unset, uses AI_SERVICE_DEPLOYMENT_NAME.
FREE_TEXT_PROMPT_DEPLOYMENT_NAME=

# --- Azure AD Authentication ---
USE_AZURE_AD=false
AI_RESOURCE_NAME=

# --- Database Configuration (Kusto) ---
DATABASE_CLUSTER=https://your-cluster.kusto.windows.net
DATABASE_NAME=YourDatabase
DATABASE_TOKEN_SCOPE=https://your-cluster.kusto.windows.net/.default

# --- Secondary Telemetry Backend (optional) ---
SECONDARY_CLUSTER=
SECONDARY_DATABASE=
SECONDARY_TOKEN_SCOPE=

# --- Cost Configuration ---
AI_SERVICE_INPUT_COST=0.01
AI_SERVICE_OUTPUT_COST=0.03

# --- Vision Service Configuration ---
VISION_API_KEY=
VISION_ENDPOINT=

# --- Article Search Configuration ---
DEFAULT_ARTICLES_EMBEDDINGS_PATH=
VECTOR_DB_PATH=
ARTICLES_BASE_PATH=

# --- Azure DevOps Configuration ---
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_DEFAULT_ASSIGNEE=
AZURE_DEVOPS_CUSTOM_FIELD1_VALUE=
AZURE_DEVOPS_REFERENCE_WORK_ITEM_ID=
AZURE_DEVOPS_REPAIR_TYPE_FIELD=Custom.RepairItemType
AZURE_DEVOPS_INCIDENT_IDS_FIELD=Custom.IncidentIDs
AZURE_DEVOPS_INCIDENT_COUNT_FIELD=Custom.IncidentCount

# --- Noise filter for automated/service-account discussion entries ---
NOISE_FILTER_AUTHOR=
NOISE_FILTER_CONTENT_PREFIX=

# --- Security agent keyword tagging (optional) ---
SECURITY_AGENT_KEYWORDS=
SECURITY_AGENT_DISPLAY_NAME=Security Agent

# --- Auto-update keyword tagging (optional) ---
AUTOUPDATE_KEYWORDS=
AUTOUPDATE_DISPLAY_NAME=Auto-Update Service

# --- Diagnostic log files to analyze from incident log bundles ---
DIAGNOSTIC_LOG_FILES=log.txt,console.txt,syslog.txt

# --- guard/ security layer (see guard/settings.py for the full list) ---
GUARD_ENABLED=false
GUARD_FAIL_OPEN=false
GUARD_PRESIDIO_ENABLED=true
GUARD_LLM_DETECTOR_ENABLED=false
GUARD_INJECTION_DEFENSE_ENABLED=false
GUARD_AUDIT_DIR=.guard_audit
